generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id         String      @id @default(cuid())
  sku        String      @unique
  barcode    String?     @unique
  name       String
  unit       String      @default("pcs")
  price      Float       @default(0)
  cost       Float       @default(0)
  image      String?
  stock      Int         @default(0)
  minStock   Int         @default(5)
  isActive   Boolean     @default(true)
  categoryId String?
  category   Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  saleItems  SaleItem[]
  stockMoves StockMove[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Setting {
  id            String   @id @default("main")
  storeName     String   @default("Kopi Nusantara")
  storeAddress  String   @default("Jl. Merdeka No. 88, Bandung")
  storePhone    String   @default("0812-3456-7890")
  taxEnabled    Boolean  @default(true)
  taxRate       Float    @default(11)
  receiptFooter String   @default("Terima kasih telah berbelanja!")
  paperWidth    String   @default("80")
  managerPinHash String  @default("")
  updatedAt     DateTime @updatedAt
}

model Shift {
  id           String    @id @default(cuid())
  cashierName  String
  openingCash  Float     @default(0)
  closingCash  Float?
  expectedCash Float?
  diff         Float?
  cashSales    Float?
  nonCashSales Float?
  totalSales   Float?
  trxCount     Int?
  status       String    @default("open")
  openedAt     DateTime  @default(now())
  closedAt     DateTime?
  sales        Sale[]
}

model Sale {
  id            String     @id @default(cuid())
  invoiceNo     String     @unique
  status        String     @default("paid")
  subtotal      Float      @default(0)
  discount      Float      @default(0)
  orderDiscount Float      @default(0)
  tax           Float      @default(0)
  total         Float      @default(0)
  paidAmount    Float      @default(0)
  changeAmount  Float      @default(0)
  method        String     @default("cash")
  orderType     String     @default("takeaway")
  note          String?
  cashierName   String     @default("Kasir")
  shiftId       String?
  shift         Shift?     @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  voidReason    String?
  voidedAt      DateTime?
  items         SaleItem[]
  createdAt     DateTime   @default(now())
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name      String
  qty       Int     @default(1)
  price     Float   @default(0)
  cost      Float   @default(0)
  discount  Float   @default(0)
  subtotal  Float   @default(0)
}

model StockMove {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      String
  qty       Int
  note      String?
  refId     String?
  createdAt DateTime @default(now())
}

model Device {
  id        String   @id @default(cuid())
  name      String
  kind      String   @default("client")
  platform  String
  version   String   @default("1.0.0")
  status    String   @default("online")
  isBlocked Boolean  @default(false)
  lastSeen  DateTime @default(now())
  createdAt DateTime @default(now())
}
